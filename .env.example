# ================================
# 🌐 Application Configuration
# ================================

# Copy this file to .env. Optional settings can stay commented out.
# Never commit the resulting .env file.

# Public address used for notification links and provider integrations.
# Open SlickSync at its normal address to let it discover the URL automatically.
# PUBLIC_APP_URL=https://slicksync.example.com

# Fallback timezone for daily watch totals and streaks.
# Override this per account in Settings > Privacy & Display.
# ACCOUNT_TIMEZONE=America/Los_Angeles

# Server and browser debug logging. Leave disabled for normal use.
DEBUG=false
NEXT_PUBLIC_DEBUG=false

# ================================
# 🔐 Private Instance Authentication
# ================================

# Required by both Docker Compose files to sign login sessions.
# Generate a random value with: openssl rand -base64 32
JWT_SECRET=

# Set both values to enable the private instance login screen.
# Leave unset only when an external authentication proxy protects the app.
# SLICKSYNC_PRIVATE_USERNAME=
# SLICKSYNC_PRIVATE_PASSWORD=

# Encryption key for stored credentials. Required by public Compose.
# Private mode: leave empty to generate and persist a key on first boot.
# Preserve that volume across updates. Changing the key can make credentials unreadable.
ENCRYPTION_KEY=

# ================================
# 🐳 Container Configuration
# ================================

# UID/GID values for custom deployment setups that explicitly consume them.
# The bundled private compose file uses user 1001:1001 directly.
# Run id to find your host user's values.
UID=1000
GID=1000

# ================================
# 🎬 Nuvio Provider
# ================================

# Optional overrides for Nuvio's default public Supabase connection.
# NUVIO_SUPABASE_URL=
# NUVIO_SUPABASE_ANON_KEY=

# ================================
# 🔎 Metadata and Discovery
# ================================

# Optional self-hosted LumiereDB address for title search and IMDb data.
# Used when no address is configured in Settings. Ignored in public instance mode.
# LUMIERE_DB_URL=http://lumiere-db:8000

# Optional TMDb API key for cast and crew filmographies.
# An account's Settings value takes precedence.
# TMDB_API_KEY=

# Optional MDBList API key for importing lists and exporting catalogs.
# An account's Settings value takes precedence.
# MDBLIST_API_KEY=

# Optional RatingPosterDB key for posters with embedded ratings.
# RPDB_API_KEY=

# Optional OMDb key for Rotten Tomatoes and Metacritic ratings.
# OMDB_API_KEY=

# ================================
# 🔗 Watch History Integrations
# ================================

# SIMKL application client ID shared by the instance's user PIN connections.
# Register an application at simkl.com/settings/developer.
# SIMKL_CLIENT_ID=

# Trakt application credentials for one-time history and ratings imports.
# Register at trakt.tv/oauth/applications. The device flow does not redirect;
# the application redirect URI can remain urn:ietf:wg:oauth:2.0:oob.
# Imported connections are discarded after the import.
# TRAKT_CLIENT_ID=
# TRAKT_CLIENT_SECRET=

# Trakt tracking for Nuvio profiles uses a separate PKCE app, without a secret.
# Register <PUBLIC_APP_URL>/user/settings/tracking/callback as its redirect URI.
# TRAKT_TRACKING_CLIENT_ID=

# Simkl AUTH V2 tracking uses a public PKCE app and the media:read scope.
# Register <PUBLIC_APP_URL>/user/settings/tracking/simkl/callback.
# SIMKL_TRACKING_CLIENT_ID=

# ================================
# 👤 Single Sign-On
# ================================

# Optional OIDC provider. Set issuer, client ID, client secret, and redirect URI
# to add an SSO button alongside password login.
# OIDC_ISSUER=https://auth.example.com/application/o/slicksync/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://slicksync.example.com/api/auth/oidc/callback

# Requested scopes and the label on the sign-in button.
# OIDC_SCOPES=openid profile email
# OIDC_DISPLAY_NAME=SSO

# Private instances: optional comma-separated verified email allowlist.
# If unset, access is controlled by the OIDC provider.
# OIDC_ALLOWED_EMAILS=

# ================================
# 📺 AIOStreams Live Presence
# ================================

# Optional proxy connection for live Now Playing presence.
# Leave unset to use provider-native polling.
# AIOSTREAMS_URL=https://aiostreams.example.com
# AIOSTREAMS_AUTH_USERNAME=
# AIOSTREAMS_AUTH_PASSWORD=

# Comma-separated SlickSync user IDs used when proxy identity cannot be matched.
# AIOSTREAMS_FALLBACK_USER_IDS=

# Comma-separated client IPs excluded from proxy presence tracking.
# Include the server's own public IP to avoid counting metadata requests as watches.
# AIOSTREAMS_IGNORE_IPS=

# ================================
# 🔔 Web Push Notifications
# ================================

# VAPID subject identifying the operator. Use a valid mailto: or https: address;
# Apple's push service rejects bare .local-style subjects.
# VAPID_SUBJECT=mailto:admin@example.com

# ================================
# 💾 Vault Backups
# ================================

# Interval for decrypted Vault snapshots in data/backup/vault/.
# VAULT_BACKUP_INTERVAL_HOURS=24

# ================================
# 🛡️ Request Limits
# ================================

# General API request window and maximum requests per IP.
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=4000

# Stricter limits for credential and authentication endpoints.
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX_REQUESTS=20

# OAuth device-code polling limit.
# POLL_RATE_LIMIT_MAX_REQUESTS=60

# ================================
# 🗄️ Public Instance Configuration
# ================================

# Used by docker-compose.public.yml. Private deployments do not need them.

# PostgreSQL password for public Compose. Generate with: openssl rand -hex 32
# Use URL-safe characters because the password is embedded in DATABASE_URL.
POSTGRES_PASSWORD=

# Per-account request limits and Discover proxy limit in public mode.
# ACCOUNT_RATE_LIMIT_WINDOW_MS=900000
# ACCOUNT_RATE_LIMIT_MAX_REQUESTS=6000
# DISCOVER_RATE_LIMIT_MAX_REQUESTS=90

# Per-account backup interval in days. Use 0 to disable scheduled backups.
# Private instances configure backup schedules in Settings instead.
# PUBLIC_BACKUP_FREQUENCY_DAYS=1

# Optional operator password for the public-mode /superadmin panel.
# Leave unset to disable the panel.
# SUPERADMIN_PASSWORD=

# Maximum registered accounts. Use 0 or leave unset for no limit.
# MAX_PUBLIC_ACCOUNTS=50

# Optional Discord webhook for new account registration alerts.
# SUPERADMIN_NOTIFY_WEBHOOK_URL=
