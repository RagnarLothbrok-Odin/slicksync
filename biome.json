{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/next"],
  "linter": {
    "rules": {
      "suspicious": {
        "noConsole": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "indentWidth": 4,
      "lineWidth": 100
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "!!**/node_modules",
      "!!**/.next",
      "!!data",
      "!!logs",
      "!!work",
      "!!prisma/migrations",
      "!!**/*.min.js"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["server/**/*.js", "scripts/**/*.js", "test/**/*.js"],
      "javascript": {
        "globals": [
          "__dirname",
          "__filename",
          "Buffer",
          "process",
          "module",
          "require",
          "exports",
          "global",
          "setImmediate"
        ]
      }
    }
  ]
}
